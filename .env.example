WORDPRESS_CLIENT_ID=pon_aqui_tu_client_id
WORDPRESS_CLIENT_SECRET=pon_aqui_tu_client_secret
WORDPRESS_BRIDGE_TOKEN=pon_un_token_largo_para_el_endpoint_alentio
LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.com

# Refinado opcional de facturas con OpenAI. La clave solo debe existir en el servidor.
OPENAI_API_KEY=pon_aqui_tu_clave_de_proyecto
OPENAI_INVOICE_MODEL=gpt-5.6-terra
OPENAI_INVOICE_REASONING=low
OPENAI_INVOICE_TIMEOUT_MS=90000

# OCR de máxima precisión para el recorte manual de líneas (más lento).
RAPID_OCR_REGION_DPI=500
