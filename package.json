{
  "version": "1.1.1",
  "appVersion": "1.01.003",
  "scripts": {
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "audit:images": "node scripts/audit_image_schema_system.js",
    "qa:recompute-errors": "node recompute_engine_errors.js",
    "qa:pdf-compare": "node scripts/qa_pdf_compare.js",
    "qa:pdf-compare:write": "node scripts/qa_pdf_compare.js --write-pdf --recompute-errors",
    "legacy:generate:synthetic": "node generate_synthetic_exports.js",
    "export:wordpress": "node scripts/export_wordpress_milu.js",
    "legacy:ai:conflicts": "node legacy/export_complex_ai/scripts/ai_conflict_rules.js",
    "legacy:export:review": "node legacy/export_complex_ai/scripts/export_review_pipeline.js all",
    "pages:prepare": "node scripts/prepare-pages-dist.js",
    "pages:prepare:dry": "node scripts/prepare-pages-dist.js --dry-run",
    "pages:prepare:incremental": "node scripts/prepare-pages-dist.js --incremental",
    "pages:prepare:incremental:dry": "node scripts/prepare-pages-dist.js --incremental --dry-run",
    "pages:bundle": "npm run pages:prepare",
    "pages:bundle:nopdf": "npm run pages:prepare",
    "pages:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-pages.ps1",
    "pages:publish:nopush": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-pages.ps1 -NoPush",
    "pages:publish:stage-only": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-pages.ps1 -NoCommit -NoPush",
    "pages:publish:full": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-pages.ps1 -FullPrepare",
    "pages:publish:full:nopush": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-pages.ps1 -FullPrepare -NoPush",
    "pages:publish:safe": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-safe.ps1",
    "git:backup": "powershell -ExecutionPolicy Bypass -File ./scripts/git-backup.ps1",
    "release:folder": "node scripts/build-release-folder.js",
    "release:folder:dry": "node scripts/build-release-folder.js --dry-run",
    "release:folder:no-bump": "node scripts/build-release-folder.js --no-bump",
    "release:folder:no-cleanup": "node scripts/build-release-folder.js --no-cleanup",
    "release:folder:keep10": "node scripts/build-release-folder.js --keep-last=10",
    "test": "npm run test:all-smoke",
    "test:smoke": "node --test tests/smoke/http-smoke.test.js",
    "test:security": "node --test tests/security/write-validation.test.js",
    "validate:engines": "node scripts/validate_engine_contracts.js",
    "db:import": "node scripts/db/import_engines_to_sqlite.js",
    "db:validate": "node scripts/db/validate_sqlite_mirror.js",
    "db:queries": "node scripts/db/sqlite_sample_queries.js",
    "db:index": "node scripts/db/create_sqlite_indexes.js",
    "test:db-read": "node --test tests/smoke/db-read-smoke.test.js",
    "test:db-analytics": "node --test tests/smoke/db-analytics-smoke.test.js",
    "test:all-smoke": "npm run test:smoke && npm run test:db-read && npm run test:db-analytics"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "better-sqlite3": "^12.10.0"
  }
}